DATABASE_URL=sqlite:///./aegis.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000
# Local Next.js proxy; omit when using the combined Vercel deployment.
BACKEND_URL=http://127.0.0.1:8000
